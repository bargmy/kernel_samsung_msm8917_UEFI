## @file
# MSM8917 Samsung J250F SDCC1 eMMC user-area firmware BlockIo provider
# SPDX-License-Identifier: GPL-2.0-only
[Defines]
  INF_VERSION                    = 0x00010017
  BASE_NAME                      = J250fEmmcDxe
  FILE_GUID                      = 3ed39ce3-101b-40f1-9fd9-6b69da4ad95f
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = J250fEmmcDxeEntryPoint

[Sources]
  J250fEmmcDxe.c
  Core/j250f_emmc.c
  Core/j250f_board.c

[Packages]
  MdePkg/MdePkg.dec
  QcomPkg/QcomPkg.dec
  J250fPkg/J250fPkg.dec

[LibraryClasses]
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  BaseLib
  BaseMemoryLib
  IoLib
  TimerLib
  DebugLib
  SerialPortLib
  PrintLib

[Protocols]
  gJ250fEmmcPowerProtocolGuid  ## CONSUMES
  gEfiBlockIoProtocolGuid      ## PRODUCES
  gEfiDevicePathProtocolGuid   ## PRODUCES

[Guids]
  gJ250fEmmcDevicePathGuid

# Deliberately waits for the target platform RPM/PMIC supply implementation.
[Depex]
  gJ250fEmmcPowerProtocolGuid
